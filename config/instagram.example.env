# Copy to instagram.env (gitignored) and fill in real values.
# Do not commit secrets. Never paste tokens into chat.

INSTAGRAM_GRAPH_VERSION=v21.0
# Instagram professional account id (instagram_business_account), not the @handle
INSTAGRAM_USER_ID=
# Long-lived Page access token with instagram_content_publish
INSTAGRAM_ACCESS_TOKEN=

# Optional. Public HTTPS base for still photos (Instagram cannot read local JPG/PNG).
# Example: https://your-cdn.example.com/band-media
# Image URL becomes {base}/{filename from media/library}
INSTAGRAM_PUBLIC_MEDIA_BASE_URL=
