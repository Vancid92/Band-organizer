# Copy to youtube.env (gitignored) and fill in real values.
# Do not commit secrets. Never paste tokens into chat.

# OAuth Desktop client from Google Cloud (YouTube Data API v3)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Filled by: python scripts/youtube_auth.py
YOUTUBE_REFRESH_TOKEN=

# public | unlisted | private
YOUTUBE_PRIVACY_STATUS=unlisted
# YouTube category: 10 = Music
YOUTUBE_CATEGORY_ID=10
